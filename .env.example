# Environment Variables Template for Cloud-Based Student Attendance Management System
# Copy this file to .env for local development

# PostgreSQL Database URL
# Local Docker instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_db?schema=public"
# AWS RDS Production instance example:
# DATABASE_URL="postgresql://dbadmin:<PASSWORD>@attendance-postgres-db.<REGION>.rds.amazonaws.com:5432/attendance_db?schema=public&sslmode=require"

# JWT Authentication Secret (Minimum 32 characters)
AUTH_SECRET="attendance_academic_secure_jwt_secret_key_2026_dev_mode"

# Public Application URL
APP_URL="http://localhost:3000"

# Default Seed Credentials
SEED_ADMIN_EMAIL="admin@attendance.edu"
SEED_ADMIN_PASSWORD="AdminPassword123!"

